#!/bin/sh
set -eu

echo "== udevadm =="
if [ -d /dev/serial/by-id ]; then
  for dev in /dev/serial/by-id/*; do
    [ -e "$dev" ] || continue
    echo "-- $dev --"
    /usr/bin/udevadm info --query=property --name="$dev"
    echo
  done
else
  echo "/dev/serial/by-id not found"
  echo
fi

echo "== ls -l /dev/serial/by-id/ =="
ls -l /dev/serial/by-id/ 2>&1 || true
echo

echo "== ls -l /dev/serial/by-path/ =="
ls -l /dev/serial/by-path/ 2>&1 || true
echo

echo "== lsusb =="
/usr/bin/lsusb 2>&1 || true
